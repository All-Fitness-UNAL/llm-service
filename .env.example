# All Fitness AI Gateway Configuration

# Redis Settings
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TASK_QUEUE=allfitness:tasks:queue
REDIS_RESULT_PREFIX=allfitness:results:
REDIS_RESULT_TTL=15m

# Worker Settings
WORKER_COUNT=5
SHUTDOWN_TIMEOUT=15s
MAX_REPAIR_RETRIES=2

# OpenRouter Settings
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://allfitness.com
OPENROUTER_APP_NAME=All Fitness AI Gateway
OPENROUTER_MAX_RETRIES=3
OPENROUTER_TIMEOUT=60s

# Prompts Directory
PROMPTS_DIR=./prompts

# Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO

# Set to true to test locally without an OpenRouter API key
MOCK_OPENROUTER=false
